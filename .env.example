# Copy to `.env` (git-ignored) and edit. The agent loads this file at startup.
#
# Laya is SELF-HOSTED: these variables tell the agent where your own
# `laya-serve` process is listening. Start it in another terminal with:
#
#     pip install "laya[serve]"
#     LAYA_MODELS=english LAYA_HOST=127.0.0.1 laya-serve
#
# ---------------------------------------------------------------------------
# Decision backend (Laya)
# ---------------------------------------------------------------------------
LAYA_API_URL=http://127.0.0.1:8000/v1/systemone

# Which checkpoint decides: english | multilingual | typed-decisions | auto.
# `english` is pinned deliberately for experiments so the model cannot change
# under a sweep; `auto` lets Laya's router choose per request (the answering
# checkpoint is still recorded as `provider_model` on every step).
LAYA_MODEL=english

# NO KEY IS REQUIRED BY DEFAULT. A `laya-serve` started without LAYA_API_KEY
# has no authentication at all - the model runs on your own hardware, so there
# is no vendor account involved.
#
# Set this ONLY if you started the server with `LAYA_API_KEY=...` (for example
# when it is exposed beyond localhost). Then also set auth_required: true in
# configs/default.yaml so a missing key fails closed instead of wasting a
# round-trip per step.
# LAYA_API_KEY=

# Local host, but a cold start loads/downloads a checkpoint before the first
# answer, so this is deliberately more generous than a hosted API.
LAYA_REQUEST_TIMEOUT_S=5.0

# Laya answers a saturated worker with 503 + Retry-After; one retry rides it out.
LAYA_MAX_RETRIES=1

# `true` when the server sets LAYA_API_KEY (mirrors agent.laya_api.auth_required)
# LAYA_AUTH_REQUIRED=false

# ---------------------------------------------------------------------------
# Rover hardware bridge (see docs/HARDWARE_DEPLOYMENT.md)
# These describe the rover, not the model, so they carry no model name.
# ---------------------------------------------------------------------------
# ROVER_BACKEND=sim            # sim | ros2 | serial
# ROVER_SERIAL_PORT=/dev/ttyUSB0
# ROVER_ROS2_NS=/laya_rover
